# DepPhantom Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — suitable for local development and single-instance deploy)
DATABASE_URL=sqlite+aiosqlite:///./depphantom.db

# PostgreSQL (for production multi-instance deployments)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/depphantom

# ── Registry API ─────────────────────────────────────────────────────────────
PYPI_API_URL=https://pypi.org/pypi
NPM_API_URL=https://registry.npmjs.org
PYPISTATS_API_URL=https://pypistats.org/api

# Timeout for registry API calls (seconds)
REGISTRY_TIMEOUT=10.0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ── Risk Thresholds ───────────────────────────────────────────────────────────
TYPOSQUATTING_SIMILARITY_THRESHOLD=0.80
NEW_PACKAGE_AGE_DAYS=30
LOW_DOWNLOAD_THRESHOLD=100

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# When true, demo scenarios are available. Does NOT disable live analysis.
# Set to false in production unless you want demo endpoints enabled.
DEMO_MODE=false
